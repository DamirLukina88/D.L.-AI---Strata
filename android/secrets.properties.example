# secrets.properties.example
# Copy this file to secrets.properties and fill in your local details.
# DO NOT commit secrets.properties to version control.

# Local LAN URL to Strata engine (e.g. http://192.168.1.100:8080)
STRATA_LAN_URL=http://192.168.3.200:8080

# Remote Cloudflare Tunnel URL to Strata engine (e.g. https://ai.example.com)
STRATA_REMOTE_URL=https://ai.damir-lukina.com

# Strata API Bearer Key (from ~/.config/dl-ai/secrets.env)
STRATA_API_KEY=your_strata_api_key_here
