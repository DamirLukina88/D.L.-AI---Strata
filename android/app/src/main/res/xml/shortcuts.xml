<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon shortcuts (long-press Ray on the home screen) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="setup"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_setup_short"
        android:shortcutLongLabel="@string/shortcut_setup_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.damirl.ray"
            android:targetClass="com.damirl.ray.OnboardingActivity" />
    </shortcut>
</shortcuts>
