    <style name="Theme.Ray" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Ray.Translucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
